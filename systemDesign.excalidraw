    {
      "id": "-FnkgH_0UZqnokOvRrLg5",
      "type": "text",
      "x": 332,
      "y": 979,
      "width": 744.1798706054688,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
